OPENAI_API_KEY=
GEMINI_API_KEY=

# Required together before OPENAI_API_KEY is enabled on the public demo.
# Railway health checks remain public; Experience and Inspect use HTTP Basic Auth.
TWINKL_DEMO_USERNAME=
TWINKL_DEMO_PASSWORD=

# Weekly Coach narrative provider: openai (default) or gemini
TWINKL_COACH_PROVIDER=openai
# Optional model override for the selected provider
# TWINKL_COACH_MODEL=
